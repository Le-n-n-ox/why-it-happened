
# Copy this file to .env and fill it in. NEVER commit .env.
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_TIMEOUT_SECONDS=90
# Comma-separated language codes: en, sw, fr, es
NARRATION_LANGS=en
# Seconds between replayed events
REPLAY_DELAY=0.5
EVENTS_FILE=data/demo_match.json
DB_PATH=insights.db

VITE_API_URL=http://127.0.0.1:8001