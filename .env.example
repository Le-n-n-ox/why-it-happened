

# Copy this file to .env and fill it in. NEVER commit .env.
NVIDIA_API_KEY=
NVIDIA_MODEL=

NVIDIA_API_KEY=your-api-key-here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b



NVIDIA_TIMEOUT_SECONDS=20
# Comma-separated language codes: en, sw, fr, es
NARRATION_LANGS=en
# Narrate the match's captions in the background at start-up so the first replay is already
# cached (1), or wait for them during the replay (0).
WARM_CACHE=1
# Seconds between replayed events
REPLAY_DELAY=0.5
EVENTS_FILE=data/demo_match.json
DB_PATH=insights.db

VITE_API_URL=http://127.0.0.1:8001
